# 使用本地构建的简化Dockerfile
FROM node:20-alpine AS runner

# 接受版本参数
ARG VERSION=latest

# 创建非 root 用户
RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nextjs -G nodejs

WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3001
ENV DOCKER_ENV=true
ENV APP_VERSION=${VERSION}

# 添加版本标签
LABEL version="${VERSION}"
LABEL maintainer="MoonTV Team"
LABEL description="MoonTV - 影视信息搜索服务"

# 复制构建好的文件
COPY --chown=nextjs:nodejs .next/server ./.next/server
COPY --chown=nextjs:nodejs .next/static ./.next/static
COPY --chown=nextjs:nodejs .next/BUILD_ID ./.next/BUILD_ID
COPY --chown=nextjs:nodejs .next/*.json ./.next/
COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs config.json ./config.json
COPY --chown=nextjs:nodejs start.js ./start.js
COPY --chown=nextjs:nodejs package.json ./package.json
COPY --chown=nextjs:nodejs node_modules ./node_modules
COPY --chown=nextjs:nodejs scripts ./scripts

# 切换到非特权用户
USER nextjs

EXPOSE 3001

# 使用Next.js启动命令
CMD ["npm", "start"]
